FROM python:3.12-slim AS builder
WORKDIR /app
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

COPY packages/db/ packages/db/
COPY packages/ingestion/ packages/ingestion/
COPY packages/api/pyproject.toml packages/api/uv.lock* packages/api/

WORKDIR /app/packages/api
RUN uv sync --no-dev

FROM python:3.12-slim
WORKDIR /app/packages/api
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
COPY --from=builder /app /app
COPY packages/api/src/ src/
COPY packages/db/alembic/ /app/packages/db/alembic/
COPY packages/db/alembic.ini /app/packages/db/alembic.ini
COPY packages/api/entrypoint.sh /entrypoint.sh

RUN useradd -m appuser && chown -R appuser:appuser /app && chmod +x /entrypoint.sh
USER appuser

CMD ["/entrypoint.sh"]
