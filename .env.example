# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/research_assistant

# LLM Service (vLLM OpenAI-compatible)
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=unused
LLM_MODEL=granite-3.1-8b-instruct

# Embedding Service (vLLM OpenAI-compatible)
EMBED_BASE_URL=http://localhost:8001/v1
EMBED_API_KEY=unused
EMBED_MODEL=nomic-embed-text

# Ingestion
MAX_DOCUMENT_SIZE_MB=250
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# UI (dev)
VITE_API_BASE_URL=http://localhost:8080
